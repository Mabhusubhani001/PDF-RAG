# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_QDRANT_URL=http://localhost:6333
LOCAL_LLM_MODEL=llama3.1
LOCAL_EMBEDDING_MODEL=qwen-embedding
LOCAL_COLLECTION_NAME=pdf_rag_local

# Cloud AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
QDRANT_CLOUD_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_CLOUD_API_KEY=your_qdrant_cloud_api_key_here
CLOUD_LLM_MODEL=gemini-1.5-flash
CLOUD_EMBEDDING_MODEL=text-embedding-004
CLOUD_COLLECTION_NAME=pdf_rag_cloud
