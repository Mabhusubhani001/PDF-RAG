---
import SectionEyebrow from './SectionEyebrow.astro';
---

<footer class="w-full border-t border-[#212327] bg-[#0a0a0a] py-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-1 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded bg-white/10 flex items-center justify-center">
            <span class="font-mono text-xs font-bold text-white">R</span>
          </div>
          <span class="text-white font-medium text-sm">PDF RAG Playground</span>
        </div>
        <p class="text-xs text-zinc-400 leading-relaxed">
          An interactive, production-grade educational platform designed to illuminate Retrieval-Augmented Generation mechanics through visual PDF exploration.
        </p>
      </div>

      <!-- Col 2: Architecture -->
      <div class="space-y-3">
        <SectionEyebrow text="PIPELINES" />
        <ul class="space-y-2 text-xs text-zinc-400">
          <li>
            <a href="/local" class="hover:text-white transition-colors flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              Local AI (Ollama + Qdrant)
            </a>
          </li>
          <li>
            <a href="/cloud" class="hover:text-white transition-colors flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
              Cloud AI (Gemini + Qdrant Cloud)
            </a>
          </li>
          <li>
            <span class="text-zinc-500">Vector Embeddings (768d / 1536d)</span>
          </li>
          <li>
            <span class="text-zinc-500">Cosine Similarity Search</span>
          </li>
        </ul>
      </div>

      <!-- Col 3: Tech Stack -->
      <div class="space-y-3">
        <SectionEyebrow text="STACK" />
        <ul class="space-y-2 text-xs text-zinc-400">
          <li>Frontend: Astro + Tailwind CSS</li>
          <li>Backend: FastAPI (Python 3.11+)</li>
          <li>LLMs: Llama 3.1 / Gemini 1.5/2.0</li>
          <li>Vector DB: Qdrant Engine</li>
        </ul>
      </div>

      <!-- Col 4: Educational Note -->
      <div class="space-y-3">
        <SectionEyebrow text="DESIGN PHILOSOPHY" />
        <p class="text-xs text-zinc-400 leading-relaxed">
          Engineered to expose every step of the RAG pipeline—from chunking strategies and vector generation to vector similarity lookup and prompt composition.
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[#212327] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-mono">
      <div>
        <span>PDF RAG Playground // Open Educational Architecture</span>
      </div>
      <div class="flex items-center gap-6">
        <span>Dark Canvas Engine</span>
        <span>Version 1.0.0</span>
      </div>
    </div>
  </div>
</footer>
