---
import ButtonPill from './ButtonPill.astro';

interface Props {
  currentMode?: 'local' | 'cloud' | 'none';
}

const { currentMode = 'none' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-[#212327] bg-[#0a0a0a]/80 backdrop-blur-md transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group text-decoration-none">
      <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/15 flex items-center justify-center group-hover:border-white/40 transition-colors">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-white font-medium text-sm tracking-tight group-hover:text-white transition-colors flex items-center gap-2">
          PDF RAG
          <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded bg-white/10 text-zinc-300 border border-white/10 tracking-wider">
            PLAYGROUND
          </span>
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1">
      <a 
        href="/" 
        class={`px-3 py-1.5 text-sm rounded-full transition-colors ${currentPath === '/' ? 'text-white bg-white/10 font-medium' : 'text-zinc-400 hover:text-white hover:bg-white/5'}`}
      >
        Overview
      </a>
      <a 
        href="/local" 
        class={`px-3 py-1.5 text-sm rounded-full transition-colors flex items-center gap-1.5 ${currentPath.startsWith('/local') ? 'text-amber-300 bg-amber-500/10 font-medium border border-amber-500/30' : 'text-zinc-400 hover:text-white hover:bg-white/5'}`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        Local AI
      </a>
      <a 
        href="/cloud" 
        class={`px-3 py-1.5 text-sm rounded-full transition-colors flex items-center gap-1.5 ${currentPath.startsWith('/cloud') ? 'text-purple-300 bg-purple-500/10 font-medium border border-purple-500/30' : 'text-zinc-400 hover:text-white hover:bg-white/5'}`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
        Cloud AI
      </a>
    </nav>

    <!-- Right Side CTAs -->
    <div class="flex items-center gap-3">
      {currentPath.startsWith('/local') ? (
        <span class="font-mono text-xs text-amber-300 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/30 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Ollama + Qdrant
        </span>
      ) : currentPath.startsWith('/cloud') ? (
        <span class="font-mono text-xs text-purple-300 bg-purple-500/10 px-3 py-1 rounded-full border border-purple-500/30 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
          Gemini + Qdrant Cloud
        </span>
      ) : (
        <ButtonPill href="/local" size="sm" variant="outline">
          Get Started
        </ButtonPill>
      )}
    </div>
  </div>
</header>
