---
interface Props {
  status: 'ready' | 'running' | 'pending' | 'error' | 'local' | 'cloud';
  label: string;
  class?: string;
}

const { status, label, class: className = '' } = Astro.props;

const dotColor = {
  ready: 'bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]',
  running: 'bg-amber-400 animate-pulse shadow-[0_0_8px_rgba(251,191,36,0.6)]',
  pending: 'bg-zinc-500',
  error: 'bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.6)]',
  local: 'bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]',
  cloud: 'bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.6)]'
};

const badgeBorder = {
  ready: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300',
  running: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
  pending: 'border-zinc-700 bg-zinc-800/50 text-zinc-400',
  error: 'border-rose-500/30 bg-rose-500/10 text-rose-300',
  local: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
  cloud: 'border-purple-500/30 bg-purple-500/10 text-purple-300'
};
---

<span class={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono border ${badgeBorder[status]} ${className}`}>
  <span class={`w-2 h-2 rounded-full ${dotColor[status]}`}></span>
  <span>{label}</span>
</span>
