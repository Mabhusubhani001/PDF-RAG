---
interface Props {
  href?: string;
  variant?: 'outline' | 'primary' | 'ghost' | 'sunset' | 'dusk';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'outline',
  size = 'md',
  type = 'button',
  class: className = '',
  id,
  ...rest
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-normal transition-all duration-200 cursor-pointer rounded-full select-none";

const sizeStyles = {
  sm: "px-3 py-1 text-xs gap-1.5",
  md: "px-5 py-2 text-sm gap-2",
  lg: "px-6 py-3 text-base gap-2.5"
};

const variantStyles = {
  outline: "border border-white/20 bg-transparent text-white hover:border-white hover:bg-white/5 active:scale-[0.98]",
  primary: "border border-white bg-white text-[#0a0a0a] font-medium hover:bg-zinc-200 active:scale-[0.98]",
  ghost: "border border-transparent bg-transparent text-zinc-300 hover:text-white hover:bg-white/5",
  sunset: "border border-amber-500/40 bg-amber-500/10 text-amber-300 hover:border-amber-400 hover:bg-amber-500/20 active:scale-[0.98]",
  dusk: "border border-purple-500/40 bg-purple-500/10 text-purple-300 hover:border-purple-400 hover:bg-purple-500/20 active:scale-[0.98]"
};

const combinedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClasses} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClasses} id={id} {...rest}>
      <slot />
    </button>
  )
}
