---
import Layout from '../../layouts/Layout.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import Card from '../../components/common/Card.astro';
import ButtonPill from '../../components/common/ButtonPill.astro';
---

<Layout 
  title="Local RAG Chat & Retrieval Inspector | Ollama & Qdrant"
  description="Chat with your PDF document locally using Llama 3.1 and inspect retrieved vector chunks, page numbers, and cosine similarity."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Top Bar Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[#212327] pb-4">
      <div class="flex items-center gap-3">
        <div class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></div>
        <div>
          <h1 class="text-xl font-normal text-white flex items-center gap-2">
            Local PDF RAG Session
            <span class="text-xs font-mono text-amber-300 bg-amber-500/10 px-2.5 py-0.5 rounded-full border border-amber-500/30">
              Llama 3.1 + Qwen
            </span>
          </h1>
          <p class="text-xs text-zinc-400 font-mono">
            Active Document: <span id="active-filename-title" class="text-amber-300">Attention_Is_All_You_Need.pdf</span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <ButtonPill href="/local/upload" variant="outline" size="sm">
          Change PDF Document
        </ButtonPill>
      </div>
    </div>

    <!-- Main Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT SIDE: CONVERSATION THREAD (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Chat Container Card -->
        <Card class="bg-[#141416] border-[#212327] min-h-[560px] flex flex-col justify-between p-6">
          
          <!-- Message Thread List -->
          <div class="space-y-6 overflow-y-auto max-h-[460px] pr-2" id="chat-messages-container">
            
            <!-- System Welcome Message -->
            <div class="p-4 rounded-lg bg-black/40 border border-amber-500/20 space-y-2 animate-fade-in">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-amber-400 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                  LOCAL RAG SYSTEM INITIALIZED
                </span>
                <span class="text-[11px] font-mono text-zinc-500" id="welcome-chunks-badge">Payload Filter Active</span>
              </div>
              <p class="text-xs text-zinc-300 leading-relaxed">
                Vector collection is isolated strictly for <strong id="welcome-file-text" class="text-amber-300">document.pdf</strong>. Ask any question below to inspect exact vector retrieval passages.
              </p>
            </div>

          </div>

          <!-- Prompt Input Form -->
          <div class="pt-4 border-t border-[#212327] space-y-3">
            <!-- Quick Prompts -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 text-[11px] font-mono">
              <span class="text-zinc-500 shrink-0">Try:</span>
              <button type="button" class="quick-prompt-btn px-2.5 py-1 rounded-full bg-black/40 border border-white/10 hover:border-amber-400 text-zinc-300 shrink-0">
                Summarize key findings
              </button>
              <button type="button" class="quick-prompt-btn px-2.5 py-1 rounded-full bg-black/40 border border-white/10 hover:border-amber-400 text-zinc-300 shrink-0">
                Who am I according to this document?
              </button>
              <button type="button" class="quick-prompt-btn px-2.5 py-1 rounded-full bg-black/40 border border-white/10 hover:border-amber-400 text-zinc-300 shrink-0">
                List main concepts
              </button>
            </div>

            <!-- Input Box -->
            <form id="chat-input-form" class="relative">
              <input 
                type="text" 
                id="user-input-field" 
                placeholder="Ask a question about your uploaded PDF..." 
                class="w-full bg-[#0a0a0a] border border-[#2d2f36] rounded-full px-5 py-3 pr-28 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-amber-500/60 transition-colors"
                aria-label="User query input"
              />
              <button 
                type="submit" 
                class="absolute right-2 top-1.5 pill-button-primary text-xs px-4 py-1.5"
                aria-label="Send Query"
              >
                Send Query
              </button>
            </form>
          </div>

        </Card>
      </div>

      <!-- RIGHT SIDE: DOCUMENT STATS & RETRIEVAL VISUALIZATION (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Document Information Card -->
        <Card class="space-y-4 bg-[#141416] border-[#212327]">
          <div class="flex items-center justify-between border-b border-[#212327] pb-3">
            <SectionEyebrow text="DOCUMENT & VECTOR STATS" />
            <span class="font-mono text-[10px] text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
              QDRANT LOCAL
            </span>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 rounded bg-black/40 border border-white/5 space-y-1">
              <span class="text-zinc-500 font-mono text-[10px] block">TOTAL PAGES</span>
              <span class="text-white font-medium text-sm" id="stats-pages">1 Page</span>
            </div>
            <div class="p-3 rounded bg-black/40 border border-white/5 space-y-1">
              <span class="text-zinc-500 font-mono text-[10px] block">TOTAL CHUNKS</span>
              <span class="text-amber-400 font-mono font-medium text-sm" id="stats-chunks">2 Chunks</span>
            </div>
            <div class="p-3 rounded bg-black/40 border border-white/5 space-y-1">
              <span class="text-zinc-500 font-mono text-[10px] block">EMBEDDING MODEL</span>
              <span class="text-zinc-300 font-mono text-xs">qwen-embedding (1024d)</span>
            </div>
            <div class="p-3 rounded bg-black/40 border border-white/5 space-y-1">
              <span class="text-zinc-500 font-mono text-[10px] block">ANSWER LLM</span>
              <span class="text-zinc-300 font-mono text-xs">Llama 3.1 (Local)</span>
            </div>
          </div>
        </Card>

        <!-- RETRIEVAL VISUALIZATION PANEL -->
        <Card class="space-y-4 bg-[#141416] border-amber-500/30" id="retrieval-panel">
          <div class="flex items-center justify-between border-b border-[#212327] pb-3">
            <SectionEyebrow text="RETRIEVAL CHUNK INSPECTOR" />
            <span class="text-[11px] font-mono text-amber-300">COSINE SIMILARITY</span>
          </div>

          <!-- Retrieved Chunks List -->
          <div class="space-y-3" id="retrieved-chunks-list">
            <span class="text-xs font-mono text-zinc-400 block">Retrieved Vector Chunks (Filtered by Active Document):</span>
            <div class="p-4 rounded-lg bg-black/40 border border-white/5 text-xs text-zinc-400 font-mono">
              Ask a question above to perform real-time vector search retrieval.
            </div>
          </div>
        </Card>

      </div>

    </div>
  </div>
</Layout>

<script>
  import { queryRagChat } from '../../utils/api';

  const form = document.getElementById('chat-input-form');
  const input = document.getElementById('user-input-field') as HTMLInputElement;
  const messagesContainer = document.getElementById('chat-messages-container');
  const quickBtns = document.querySelectorAll('.quick-prompt-btn');
  const retrievedChunksList = document.getElementById('retrieved-chunks-list');

  const activeFilenameTitle = document.getElementById('active-filename-title');
  const welcomeFileText = document.getElementById('welcome-file-text');
  const statsPages = document.getElementById('stats-pages');
  const statsChunks = document.getElementById('stats-chunks');

  let activeDocFilename = 'Attention_Is_All_You_Need.pdf';

  if (typeof window !== 'undefined') {
    activeDocFilename = sessionStorage.getItem('active_pdf_name') || 'Attention_Is_All_You_Need.pdf';
    const pages = sessionStorage.getItem('active_pdf_pages') || '15 Pages';
    const chunks = sessionStorage.getItem('active_pdf_chunks') || '38 Chunks';

    if (activeFilenameTitle) activeFilenameTitle.textContent = activeDocFilename;
    if (welcomeFileText) welcomeFileText.textContent = activeDocFilename;
    if (statsPages) statsPages.textContent = pages;
    if (statsChunks) statsChunks.textContent = chunks;
  }

  function appendUserMessage(text: string) {
    if (!messagesContainer) return;
    const userDiv = document.createElement('div');
    userDiv.className = 'flex justify-end animate-fade-in';
    userDiv.innerHTML = `
      <div class="max-w-lg p-3.5 rounded-2xl rounded-tr-none bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs space-y-1">
        <div class="font-mono text-[10px] text-amber-400/80">USER QUESTION</div>
        <p>${text}</p>
      </div>
    `;
    messagesContainer.appendChild(userDiv);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  function appendLoadingSkeleton() {
    if (!messagesContainer) return null;
    const skelDiv = document.createElement('div');
    skelDiv.className = 'flex justify-start animate-fade-in';
    skelDiv.innerHTML = `
      <div class="max-w-2xl p-4 rounded-2xl rounded-tl-none bg-[#18181a] border border-amber-500/20 text-zinc-200 text-xs space-y-3 w-full">
        <div class="flex items-center justify-between border-b border-white/5 pb-2">
          <span class="font-mono text-[10px] text-amber-300 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            FILTERING QDRANT FOR '${activeDocFilename}' & GENERATING RESPONSE...
          </span>
        </div>
        <div class="space-y-2 animate-pulse">
          <div class="h-3 bg-white/10 rounded w-5/6"></div>
          <div class="h-3 bg-white/10 rounded w-4/6"></div>
        </div>
      </div>
    `;
    messagesContainer.appendChild(skelDiv);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    return skelDiv;
  }

  async function handleUserQuery(queryText: string) {
    appendUserMessage(queryText);
    const skeletonEl = appendLoadingSkeleton();

    // Query RAG backend with active document filename filter
    const response = await queryRagChat(queryText, 'local', 3, activeDocFilename);

    if (skeletonEl) skeletonEl.remove();

    const botAnswer = response?.answer || `Could not complete RAG query. Please ensure Qdrant container is running ('docker run -p 6333:6333 qdrant/qdrant') and Ollama is active.`;
    const latency = response?.latency_ms || 120;
    const retrievedChunks = response?.retrieved_chunks || [];

    if (!messagesContainer) return;
    const botDiv = document.createElement('div');
    botDiv.className = 'flex justify-start animate-fade-in';
    const answerId = `ans-${Date.now()}`;
    
    botDiv.innerHTML = `
      <div class="max-w-2xl p-4 rounded-2xl rounded-tl-none bg-[#18181a] border border-amber-500/20 text-zinc-200 text-xs space-y-3">
        <div class="flex items-center justify-between border-b border-white/5 pb-2">
          <span class="font-mono text-[10px] text-amber-300 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            LOCAL RAG RESPONSE (LLAMA 3.1)
          </span>
          <span class="font-mono text-[10px] text-zinc-500">Latency: ${latency}ms // ${retrievedChunks.length} Filtered Chunks</span>
        </div>
        <p class="leading-relaxed whitespace-pre-line" id="${answerId}"></p>
      </div>
    `;
    messagesContainer.appendChild(botDiv);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    const answerP = document.getElementById(answerId);
    if (answerP) {
      let charIdx = 0;
      const interval = setInterval(() => {
        if (charIdx < botAnswer.length) {
          answerP.textContent += botAnswer[charIdx];
          charIdx++;
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        } else {
          clearInterval(interval);
        }
      }, 6);
    }

    // Render retrieved vector chunks in right inspector panel
    if (retrievedChunksList && retrievedChunks.length > 0) {
      retrievedChunksList.innerHTML = `<span class="text-xs font-mono text-zinc-400 block">Retrieved Vector Chunks (Filtered by ${activeDocFilename}):</span>`;
      retrievedChunks.forEach((chunk, i) => {
        const details = document.createElement('details');
        details.className = 'group p-3 rounded-lg bg-black/40 border border-amber-500/30 space-y-2 animate-fade-in';
        if (i === 0) details.open = true;
        details.innerHTML = `
          <summary class="flex items-center justify-between cursor-pointer list-none text-xs">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              <span class="font-mono text-amber-300 font-medium">${chunk.chunk_id} (Page ${chunk.page_number})</span>
            </div>
            <span class="font-mono text-[11px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30">
              Similarity: ${chunk.similarity_score}
            </span>
          </summary>
          <div class="pt-2 text-[11px] text-zinc-300 space-y-1.5 font-mono leading-relaxed border-t border-white/5">
            <p class="text-zinc-400"><strong>Document:</strong> <span class="text-amber-300">${chunk.filename || activeDocFilename}</span></p>
            <p class="bg-black/50 p-2 rounded border border-white/5 text-zinc-300 font-sans leading-normal">"${chunk.text_snippet}"</p>
          </div>
        `;
        retrievedChunksList.appendChild(details);
      });
    } else if (retrievedChunksList) {
      retrievedChunksList.innerHTML = `
        <div class="p-4 rounded-lg bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300 font-mono">
          No matching vector chunks found for active document '${activeDocFilename}'. Re-upload document to generate fresh vector embeddings.
        </div>
      `;
    }
  }

  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (val) {
        input.value = '';
        handleUserQuery(val);
      }
    });
  }

  quickBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.textContent?.trim();
      if (text) {
        handleUserQuery(text);
      }
    });
  });
</script>
